    {
      "name": "POST- Create Token",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "pm.environment.set(\"firstname\", \"Tester\" + Date.now());\r",
              "pm.environment.set(\"lastname\", \"QA\");"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "const res = pm.response.json();\r",
              "\r",
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Response has a non-empty token\", function () {\r",
              "    pm.expect(res.token).to.be.a(\"string\").and.not.empty;\r",
              "});\r",
              "\r",
              "pm.environment.set(\"token\", res.token);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
