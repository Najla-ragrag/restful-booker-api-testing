          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 (the API does not return 401)\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Reason is Bad credentials\", function () {\r\n    const res = pm.response.json();\r\n    pm.expect(res.reason).to.eql(\"Bad credentials\");\r\n});\r\n\r\npm.test(\"No token is returned\", function () {\r\n    const res = pm.response.json();\r\n    pm.expect(res).to.not.have.property(\"token\");\r\n});"
                ]
              }
            }
          ],
